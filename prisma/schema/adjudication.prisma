// Task 1.10. Rule sets and decisions. The rules Prisma cannot express (immutability, the explanation CHECK,
// status and outcome sets) are hand-written in migration 20261002000000_adjudication_init.

// D2: one row per whole rule set. `body` is the rules/*.json file; `contentHash` is sha256Hex(body) (D5),
// set at publish. Published rows only ever change status to retired (VP-01).
model RuleSetVersion {
  id            String     @id @default(uuid()) @db.Uuid
  kind          String // plan | ops
  product       String
  version       Int
  status        String     @default("draft") // draft | published | retired
  effectiveFrom DateTime   @db.Date
  body          Json
  contentHash   String?
  publishedAt   DateTime?  @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  planDecisions Decision[] @relation("planVersion")
  opsDecisions  Decision[] @relation("opsVersion")
  contracts     Contract[]

  @@unique([kind, product, version])
}

// Task 2.3, D36. Seeded, then read-only (trigger). Pins the plan version it was sold under (D3).
// `facts` holds the contract.* and product.* facts as the fact dictionary names them.
model Contract {
  id            String         @id // e.g. CT-0001
  planVersionId String         @db.Uuid
  planVersion   RuleSetVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  facts         Json
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
}

// Task 2.3, D36. Status and payment status are separate fields; the outcome stays on Decision.
// `contractId` is what the claimant quoted, so it has no FK: an unknown one is PL-06, not an insert error.
// `facts` holds the claim's own facts (claim.*, history.*, evidence.*, docs.*).
model Claim {
  id            String           @id
  contractId    String
  facts         Json
  status        String           @default("OPEN")
  paymentStatus String           @default("NONE")
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  decisions     Decision[]
  documents     Document[]
  waivers       DocumentWaiver[]
  enteredFacts  ClaimFact[]
}

// Task 3.2, D53. One row per (claim, document type), made by the first upload. Insert-only (trigger).
// `type` is a document type the fact dictionary names (docs.<type>); the list is rule data, not a CHECK.
model Document {
  id        String            @id @default(uuid()) @db.Uuid
  claimId   String
  claim     Claim             @relation(fields: [claimId], references: [id], onDelete: Restrict)
  type      String
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  versions  DocumentVersion[]

  @@unique([claimId, type])
}

// Task 3.2, D53. Insert-only (trigger): an upload is a new row with the next `version`, and the bytes live in the
// DocumentStore under `sha256`. No status column: a later version supersedes, and reviews and waivers are rows (3.3).
// `source` is claimant, servicer or staff (CHECK, D54).
// `uploadedBy` is a User id with no FK, as on AuditEvent (core's schema is template-owned); null = the claimant.
model DocumentVersion {
  id         String          @id @default(uuid()) @db.Uuid
  documentId String          @db.Uuid
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version    Int
  sha256     String
  source     String
  uploadedBy String?         @db.Uuid
  uploadedAt DateTime        @default(now()) @db.Timestamptz(6)
  review     DocumentReview?
  facts      ClaimFact[]

  @@unique([documentId, version])
}

// Task 3.3, D54. The five rejection reasons of domain brief §8, seeded by the migration. Data: a sixth is a row.
model DocumentRejectionReason {
  code    String           @id
  reviews DocumentReview[]
}

// Task 3.3, D53. What a person said of one version, once: accepted, or rejected with a reason. Insert-only (trigger).
model DocumentReview {
  id         String                   @id @default(uuid()) @db.Uuid
  versionId  String                   @unique @db.Uuid
  version    DocumentVersion          @relation(fields: [versionId], references: [id], onDelete: Restrict)
  result     String // accepted | rejected
  reasonCode String?
  reason     DocumentRejectionReason? @relation(fields: [reasonCode], references: [code], onDelete: Restrict)
  reviewedBy String?                  @db.Uuid
  reviewedAt DateTime                 @default(now()) @db.Timestamptz(6)
}

// Task 3.3, D53. A waiver is of the document slot, not of a version, so it needs no upload. Insert-only (trigger).
// `tier` is the tier the waiver was made at and `asOf` the day, so the power can be checked again later (D49).
model DocumentWaiver {
  id         String   @id @default(uuid()) @db.Uuid
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Restrict)
  type       String
  reasonText String
  tier       String
  asOf       DateTime @db.Date
  waivedBy   String?  @db.Uuid
  waivedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([claimId, type])
}

// Task 3.4, D55. One fact a person entered on a claim. Insert-only (trigger): a correction is a later row, and the
// latest row for a fact wins. A fact read from a document names the version and counts only while that version is
// accepted; a fact no document carries has no version and must name who entered it (CHECK).
// `enteredBy` is a User id with no FK, as on DocumentVersion.
model ClaimFact {
  id                String           @id @default(uuid()) @db.Uuid
  claimId           String
  claim             Claim            @relation(fields: [claimId], references: [id], onDelete: Restrict)
  factId            String
  value             Json
  documentVersionId String?          @db.Uuid
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  enteredBy         String?          @db.Uuid
  enteredAt         DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@unique([documentVersionId, factId])
  @@index([claimId])
}

// D4, D13, D18: append-only. A correction is a new row that supersedes; an override is a new row that overrides.
// `documentVersions` (D47): the ids of the document versions accepted when the decision was made, sorted; part of inputHash.
model Decision {
  id                         String          @id @default(uuid()) @db.Uuid
  claimId                    String
  claim                      Claim           @relation(fields: [claimId], references: [id], onDelete: Restrict)
  planVersionId              String          @db.Uuid
  planVersion                RuleSetVersion  @relation("planVersion", fields: [planVersionId], references: [id], onDelete: Restrict)
  planHash                   String
  opsVersionId               String          @db.Uuid
  opsVersion                 RuleSetVersion  @relation("opsVersion", fields: [opsVersionId], references: [id], onDelete: Restrict)
  opsHash                    String
  asOf                       DateTime        @db.Date
  facts                      Json // canonical fact snapshot
  documentVersions           String[]        @default([])
  inputHash                  String
  outputHash                 String
  engineSemanticsVersion     String
  outcome                    String // APPROVE | PARTIAL | DENY | REFER | PEND
  payableCents               Int?
  explanation                Json // the trace (adjuster.trace/*): NOT NULL + CHECK non-empty (PL-04)
  supersedesId               String?         @unique @db.Uuid
  supersedes                 Decision?       @relation("chain", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy               Decision?       @relation("chain")
  overridesId                String?         @db.Uuid
  overrides                  Decision?       @relation("override", fields: [overridesId], references: [id], onDelete: Restrict)
  overriddenBy               Decision[]      @relation("override")
  reminders                  ClaimReminder[]
  payment                    Payment?
  overrideReasonCode         String?
  overrideReason             OverrideReason? @relation(fields: [overrideReasonCode], references: [code], onDelete: Restrict)
  overrideReasonText         String?
  // Task 3.8, D48, D59: who overrode, the tier they held that day and the total incurred the tier was tested on.
  overrideTier               String?
  overrideTotalIncurredCents Int?
  overrideBy                 String?         @db.Uuid
  createdAt                  DateTime        @default(now()) @db.Timestamptz(6)

  @@index([claimId])
}

// Task 3.8, D59. The reasons an override may give, seeded by the migration. Data: a third is a row.
model OverrideReason {
  code      String     @id
  decisions Decision[]
}

// Task 3.6, D57. One row per reminder sent for a PEND decision. Insert-only (trigger). A claim's reminder level is
// the highest level on its current engine decision, so a new decision starts the count again with no update.
model ClaimReminder {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  level      Int
  asOf       DateTime @db.Date
  sentAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([decisionId, level])
}

// Task 3.9, D60. Money paid on a decision: the part of its amount the claim had not been paid yet. Insert-only
// (trigger), at most one per decision. What a claim has been paid is the sum over its decisions.
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  decisionId  String   @unique @db.Uuid
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  amountCents Int
  providerRef String
  asOf        DateTime @db.Date
  paidBy      String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
}

// Task 3.7 (D49, D58). A user's authority tier. Insert-only: the latest row for a user is the one in force, and a
// null tier takes it away. The tier's name means something only against an ops rule set's `authority` list.
model TierAssignment {
  id         Int      @id @default(autoincrement())
  userId     String   @db.Uuid
  tier       String?
  assignedBy String?  @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, id])
}
