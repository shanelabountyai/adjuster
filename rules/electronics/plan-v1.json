  "payout": {
    "steps": [
      {
        "id": "c1",
        "op": "start_from",
        "operand": {
          "fact": "claim.coveredRepairCents"
        },
        "reg": "L",
        "when": [
          {
            "fact": "lookup.path",
            "op": "eq",
            "value": "repair"
          }
        ],
        "label": "Loss = covered repair cost C (repair path)"
      },
      {
        "id": "c2",
        "op": "start_from",
        "operand": {
          "fact": "claim.replacementValueCents"
        },
        "reg": "L",
        "when": [
          {
            "fact": "lookup.path",
            "op": "eq",
            "value": "replace"
          }
        ],
        "label": "Loss = replacement value R (replace path)"
      },
      {
        "id": "c3",
        "op": "apply_bps",
        "operand": {
          "fact": "lookup.retentionBps"
        },
        "reg": "L",
        "when": [
          {
            "fact": "lookup.path",
            "op": "eq",
            "value": "replace"
          }
        ],
        "label": "Basis V: depreciate R on an ACV plan"
      },
      {
        "id": "c4",
        "op": "cap_at",
        "operand": {
          "fact": "product.purchasePriceCents"
        },
        "reg": "L",
        "label": "Limit of liability: never above purchase price"
      },
      {
        "id": "c5",
        "op": "subtract",
        "operand": {
          "fact": "lookup.deductibleCents"
        },
        "reg": "L",
        "label": "Deductible"
      },
      {
        "id": "c6",
        "op": "floor_at",
        "operand": {
          "const": 0
        },
        "reg": "L",
        "label": "Under the deductible pays 0, not negative"
      },
      {
        "id": "c7",
        "op": "start_from",
        "operand": {
          "reg": "L"
        },
        "reg": "DED",
        "label": "Remember the amount after deductible"
      },
      {
        "id": "c8",
        "op": "cap_at",
        "operand": {
          "fact": "lookup.perClaimLimitCents"
        },
        "reg": "L",
        "label": "Per-claim limit"
      },
      {
        "id": "c9",
        "op": "start_from",
        "operand": {
          "fact": "lookup.aggregateLimitCents"
        },
        "reg": "AGG",
        "label": "Aggregate limit"
      },
      {
        "id": "c10",
        "op": "subtract",
        "operand": {
          "fact": "d.sumPriorPaid"
        },
        "reg": "AGG",
        "label": "less amounts already paid (deductibles never erode it)"
      },
      {
        "id": "c11",
        "op": "floor_at",
        "operand": {
          "const": 0
        },
        "reg": "AGG"
      },
      {
        "id": "c12",
        "op": "cap_at",
        "operand": {
          "reg": "AGG"
        },
        "reg": "L",
        "label": "Aggregate remaining caps this payment"
      },
      {
        "id": "c13",
        "op": "start_from",
        "operand": {
          "reg": "AGG"
        },
        "reg": "AFTER"
      },
      {
        "id": "c14",
        "op": "subtract",
        "operand": {
          "reg": "L"
        },
        "reg": "AFTER",
        "label": "Aggregate remaining after this payment"
      }
    ],
    "outputs": {
      "payableCents": "L",
      "afterDeductibleCents": "DED",
      "aggregateRemainingAfterCents": "AFTER"
    }
  },
  "fulfillment": [
    {
      "id": "ful.replacement",
      "when": [
        {
          "fact": "lookup.path",
          "op": "eq",
          "value": "replace"
        },
        {
          "fact": "lookup.fulfillsOnReplace",
          "op": "eq",
          "value": true
        }
      ]
    },
    {
      "id": "ful.aggregate",
      "when": [
        {
          "fact": "calc.aggregateRemainingAfterCents",
          "op": "lte",
          "value": 0
        }
      ]
    }
  ]
}
