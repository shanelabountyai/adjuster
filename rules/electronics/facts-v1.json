        "to": "claim.dateReported"
      }
    },
    {
      "id": "d.daysPastWaitingEnd",
      "type": "int",
      "source": "derived",
      "description": "",
      "fn": "days_between",
      "args": {
        "from": "contract.waitingEndsOn",
        "to": "claim.dateOfLoss"
      }
    },
    {
      "id": "d.purchaseLagDays",
      "type": "int",
      "source": "derived",
      "description": "",
      "fn": "days_between",
      "args": {
