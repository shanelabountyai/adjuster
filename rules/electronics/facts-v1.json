        "to": "claim.dateOfLoss"
      }
    },
    {
      "id": "d.repairRatioBps",
      "type": "bps",
      "source": "derived",
      "description": "",
      "fn": "ratio_bps",
      "args": {
        "num": "claim.coveredRepairCents",
        "den": "claim.replacementValueCents"
      }
    },
    {
      "id": "d.estimateVsLimitBps",
      "type": "bps",
      "source": "derived",
      "description": "",
      "fn": "ratio_bps",
      "args": {
        "num": "claim.coveredRepairCents",
        "den": "lookup.perClaimLimitCents"
      }
    },
    {
      "id": "d.claims12mAll",
      "type": "int",
      "source": "derived",
      "description": "",
      "fn": "count_claims_in_window",
      "args": {
        "list": "history.priorClaims",
        "anchor": "claim.dateOfLoss",
        "windowDays": 365,
        "peril": "any",
        "counts": [
          "APPROVE",
          "PARTIAL"
        ]
      }
    },
    {
      "id": "d.claims12mAdh",
      "type": "int",
      "source": "derived",
      "description": "",
      "fn": "count_claims_in_window",
      "args": {
        "list": "history.priorClaims",
        "anchor": "claim.dateOfLoss",
        "windowDays": 365,
        "peril": [
          "adh"
        ],
        "counts": [
          "APPROVE",
          "PARTIAL"
        ]
      }
    },
    {
      "id": "d.claims60d",
      "type": "int",
      "source": "derived",
      "description": "",
      "fn": "count_claims_in_window",
      "args": {
        "list": "history.priorClaims",
        "anchor": "claim.dateOfLoss",
        "windowDays": 60,
        "peril": "any"
      }
    },
    {
      "id": "d.dupWithin7",
      "type": "int",
      "source": "derived",
      "description": "",
      "fn": "count_claims_in_window",
      "args": {
        "list": "history.priorClaims",
        "anchor": "claim.dateOfLoss",
        "windowDays": 7,
        "peril": "same"
      }
    },
    {
      "id": "d.sumPriorPaid",
      "type": "cents",
      "source": "derived",
      "description": "",
      "fn": "sum_prior_paid",
      "args": {
