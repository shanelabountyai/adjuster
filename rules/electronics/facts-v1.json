        "essential",
        "plus",
        "premier"
      ],
      "planIdentifier": true
    },
    {
      "id": "contract.status",
      "type": "enum",
      "source": "input",
      "description": "Stored contract status (E1). Term dates are E2's business.",
      "values": [
        "active",
        "cancelled",
        "lapsed"
      ]
    },
    {
      "id": "contract.termStart",
