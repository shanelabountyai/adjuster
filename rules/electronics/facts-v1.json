    {
      "id": "d.daysSinceStart",
      "type": "int",
      "source": "derived",
      "description": "",
      "fn": "days_between",
      "args": {
        "from": "contract.termStart",
        "to": "claim.dateOfLoss"
      }
    },
    {
      "id": "d.daysToTermEnd",
      "type": "int",
      "source": "derived",
      "description": "",
