{
  "schema": "adjuster.ruleset/1",
  "kind": "plan",
  "product": "furniture",
  "version": 1,
  "effectiveFrom": "2025-01-01",
  "factDictionary": "facts-v1",
  "factDictionaryHash": "e1503162c42424d8d3b4a61872e15b9a50ddd734c83a7d062198c43bb88ac6b5",
  "roundingMode": "half_up",
  "lookups": [
    {
      "id": "serviceFeeCents",
      "hitPolicy": "unique",
      "rows": [
        {
          "id": "fee.spotless",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "spotless"
            }
          ],
          "value": 0
        },
        {
          "id": "fee.everyday.stain",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "everyday"
            },
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            }
          ],
          "value": 0
        },
        {
          "id": "fee.everyday.accidental",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "everyday"
            },
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "accidental_damage"
            }
          ],
          "value": 5000
        },
        {
          "id": "fee.heirloom",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "heirloom"
            }
          ],
          "value": 0
        }
      ],
      "note": "A teaching parameter: most real furniture plans charge no fee. No row for a peril the plan does not cover; E106 denies it first."
    },
    {
      "id": "path",
      "hitPolicy": "unique",
      "rows": [
        {
          "id": "path.unrepairable",
          "when": [
            {
              "fact": "claim.repairable",
              "op": "eq",
              "value": false
            }
          ],
          "value": "replace"
        },
        {
          "id": "path.replace",
          "when": [
            {
              "fact": "claim.repairable",
              "op": "eq",
              "value": true
            },
            {
              "fact": "d.serviceExceedsReplaceBps",
              "op": "eq",
              "value": true
            }
          ],
          "value": "replace"
        },
        {
          "id": "path.repair",
          "when": [
            {
              "fact": "claim.repairable",
              "op": "eq",
              "value": true
            },
            {
              "fact": "d.serviceExceedsReplaceBps",
              "op": "eq",
              "value": false
            }
          ],
          "value": "repair"
        }
      ],
      "note": "Replace when the piece cannot be repaired, or C > 60% of R by cross-multiplication (D26). The rows that read the ratio also test repairable = true, so with no service cost they are FALSE, not UNKNOWN (V8)."
    }
  ],
  "rules": [
    {
      "id": "E120",
      "name": "Claimant is the contract holder",
      "class": "C",
      "stage": "contract_verification",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E120.pass",
          "when": [
            {
              "fact": "claim.claimantIsHolder",
              "op": "eq",
              "value": true
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E120.fail",
          "when": [
            {
              "fact": "claim.claimantIsHolder",
              "op": "eq",
              "value": false
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "NOT_HOLDER",
            "clause": "\u00a79.1",
            "claimantText": "This plan cannot be transferred, and you are not the holder on record.",
            "noteText": "Claimant is not the holder; the plan is not transferable."
          }
        }
      ],
      "note": "Contractual, and a denial, so it sits in an early stage: only stages one to five can deny."
    },
    {
      "id": "E101",
      "name": "Contract active on date of loss",
      "class": "C",
      "stage": "coverage_period",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E101.pass",
          "when": [
            {
              "fact": "contract.status",
              "op": "eq",
              "value": "active"
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E101.fail",
          "when": [
            {
              "fact": "contract.status",
              "op": "neq",
              "value": "active"
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "CONTRACT_NOT_ACTIVE",
            "clause": "\u00a72.1",
            "claimantText": "Your plan was not active on the date of loss.",
            "noteText": "Contract status is {status}.",
            "bind": {
              "status": "contract.status"
            }
          }
        }
      ]
    },
    {
      "id": "E102",
      "name": "Date of loss within term",
      "class": "C",
      "stage": "coverage_period",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E102.pass",
          "when": [
            {
              "fact": "d.daysSinceStart",
              "op": "gte",
              "value": 0
            },
            {
              "fact": "d.daysToTermEnd",
              "op": "gte",
              "value": 0
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E102.before",
          "when": [
            {
              "fact": "d.daysSinceStart",
              "op": "lt",
              "value": 0
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "OUTSIDE_TERM",
            "clause": "\u00a72.1",
            "claimantText": "The loss occurred outside your coverage term ({start}\u2013{end}).",
            "noteText": "Loss {dol} outside {start}-{end}.",
            "bind": {
              "start": "contract.termStart",
              "end": "contract.termEnd",
              "dol": "claim.dateOfLoss"
            }
          }
        },
        {
          "id": "E102.after",
          "when": [
            {
              "fact": "d.daysToTermEnd",
              "op": "lt",
              "value": 0
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "OUTSIDE_TERM",
            "clause": "\u00a72.1",
            "claimantText": "The loss occurred outside your coverage term ({start}\u2013{end}).",
            "noteText": "Loss {dol} outside {start}-{end}.",
            "bind": {
              "start": "contract.termStart",
              "end": "contract.termEnd",
              "dol": "claim.dateOfLoss"
            }
          }
        }
      ],
      "note": "The term starts on delivery, so a loss dated before delivery is denied here: the objective half of E110."
    },
    {
      "id": "E103",
      "name": "Structural cover starts after the manufacturer's warranty year",
      "class": "C",
      "stage": "coverage_period",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E103.na",
          "when": [
            {
              "fact": "claim.peril",
              "op": "neq",
              "value": "structural"
            }
          ],
          "then": {
            "outcome": "PASS",
            "noteText": "Applies to structural claims only."
          }
        },
        {
          "id": "E103.pass",
          "when": [
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "structural"
            },
            {
              "fact": "d.daysSinceStart",
              "op": "gte",
              "value": 365
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E103.before",
          "when": [
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "structural"
            },
            {
              "fact": "d.daysSinceStart",
              "op": "lt",
              "value": 0
            }
          ],
          "then": {
            "outcome": "PASS",
            "noteText": "Before delivery: E102 decides."
          }
        },
        {
          "id": "E103.fail",
          "when": [
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "structural"
            },
            {
              "fact": "d.daysSinceStart",
              "op": "between",
              "value": [
                0,
                364
              ]
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "MFR_WARRANTY_YEAR",
            "clause": "\u00a72.2",
            "params": {
              "N": 365
            },
            "claimantText": "During the first year, structural defects are covered by the manufacturer's warranty; please contact your retailer.",
            "noteText": "Structural loss {days} days after delivery; cover starts on day {N}.",
            "bind": {
              "days": "d.daysSinceStart"
            }
          }
        }
      ]
    },
    {
      "id": "E104",
      "name": "Reported within 30 days of loss",
      "class": "C",
      "stage": "coverage_period",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E104.pass",
          "when": [
            {
              "fact": "d.daysReportLag",
              "op": "lte",
              "value": 30
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E104.fail",
          "when": [
            {
              "fact": "d.daysReportLag",
              "op": "gt",
              "value": 30
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "LATE_REPORT",
            "clause": "\u00a72.3",
            "params": {
              "N": 30
            },
            "claimantText": "Your claim was reported more than {N} days after the damage occurred.",
            "noteText": "Reported {lag} days after loss.",
            "bind": {
              "lag": "d.daysReportLag"
            }
          }
        }
      ]
    },
