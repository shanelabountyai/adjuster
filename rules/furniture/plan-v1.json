    {
      "id": "E108",
      "name": "Stain: one identified incident",
      "class": "C",
      "stage": "peril_exclusions",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E108.na",
          "when": [
            {
              "fact": "claim.peril",
              "op": "neq",
              "value": "stain"
            }
          ],
          "then": {
            "outcome": "PASS",
            "noteText": "Applies to stain claims only."
          }
        },
        {
          "id": "E108.pass",
          "when": [
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            },
            {
              "fact": "claim.stainOrigin",
              "op": "eq",
              "value": "single_incident"
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E108.fail.accumulation",
          "when": [
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            },
            {
              "fact": "claim.stainOrigin",
              "op": "eq",
              "value": "accumulation"
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "ACCUMULATED_SOILING",
            "clause": "\u00a74.1",
            "claimantText": "Soiling that builds up over time is excluded.",
            "noteText": "Accumulated soiling, not one incident."
          }
        },
        {
          "id": "E108.fail.unknown",
          "when": [
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            },
            {
              "fact": "claim.stainOrigin",
              "op": "eq",
              "value": "unknown_origin"
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "STAIN_UNKNOWN_ORIGIN",
            "clause": "\u00a74.1",
            "claimantText": "Stains of unknown origin are excluded.",
            "noteText": "The holder cannot say what caused the stain."
          }
        }
      ],
      "note": "unknown_origin is an entered answer and denies. A stain claim with no answer at all pends (V7)."
    },
