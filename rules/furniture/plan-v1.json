    {
      "id": "E119",
      "name": "Total paid is below the purchase price",
      "class": "C",
      "stage": "frequency_limits",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E119.pass",
          "when": [
            {
              "fact": "d.priceExceedsPaid",
              "op": "eq",
              "value": true
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E119.fail",
          "when": [
            {
              "fact": "d.priceExceedsPaid",
              "op": "eq",
              "value": false
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "LIMIT_EXHAUSTED",
            "clause": "\u00a76.1",
            "claimantText": "Your plan's total limit, the price you paid, has been reached.",
            "noteText": "Paid {paid} of the purchase price {price}.",
            "bind": {
              "paid": "d.sumPriorPaid",
              "price": "product.purchasePriceCents"
            }
          }
        }
      ],
      "note": "The limit is a fact, so this reads a derived comparison (D81) where E16 on electronics reads a constant per plan."
    }
  ],
  "payout": {
    "steps": [
      {
        "id": "c1",
        "op": "start_from",
        "operand": {
          "fact": "claim.coveredServiceCents"
        },
        "reg": "L",
        "when": [
          {
            "fact": "lookup.path",
            "op": "eq",
            "value": "repair"
          }
        ],
        "label": "Covered cleaning or repair cost"
      },
      {
        "id": "c2",
        "op": "start_from",
        "operand": {
          "fact": "claim.replacementValueCents"
        },
        "reg": "L",
        "when": [
          {
            "fact": "lookup.path",
            "op": "eq",
            "value": "replace"
          }
        ],
        "label": "Replacement value of your piece, paid as a store credit at your retailer"
      },
      {
        "id": "c3",
        "op": "cap_at",
        "operand": {
          "fact": "product.purchasePriceCents"
        },
        "reg": "L",
        "label": "Limited to the price you paid"
      },
      {
        "id": "c4",
        "op": "subtract",
        "operand": {
          "fact": "lookup.serviceFeeCents"
        },
        "reg": "L",
        "label": "Less your service fee"
      },
      {
        "id": "c5",
        "op": "floor_at",
        "operand": {
          "const": 0
        },
        "reg": "L",
        "label": "A payment is never less than zero"
      },
      {
        "id": "c6",
        "op": "start_from",
        "operand": {
          "reg": "L"
        },
        "reg": "DED"
      },
      {
        "id": "c7",
        "op": "start_from",
        "operand": {
          "fact": "product.purchasePriceCents"
        },
        "reg": "REM",
        "label": "Your plan's total limit, the price you paid"
      },
      {
        "id": "c8",
        "op": "subtract",
        "operand": {
          "fact": "d.sumPriorPaid"
        },
        "reg": "REM",
        "label": "Less what your plan has already paid"
      },
      {
        "id": "c9",
        "op": "floor_at",
        "operand": {
          "const": 0
        },
        "reg": "REM"
      },
      {
        "id": "c10",
        "op": "cap_at",
        "operand": {
          "reg": "REM"
        },
        "reg": "L",
        "label": "Limited to what is left on your plan"
      },
      {
        "id": "c11",
        "op": "start_from",
        "operand": {
          "reg": "REM"
        },
        "reg": "AFTER"
      },
      {
        "id": "c12",
        "op": "subtract",
        "operand": {
          "reg": "L"
        },
        "reg": "AFTER",
        "label": "Left on your plan after this payment"
      }
    ],
    "outputs": {
      "payableCents": "L",
      "afterDeductibleCents": "DED",
      "remainingAfterCents": "AFTER"
    }
  },
  "fulfillment": [
    {
      "id": "ful.replacement",
      "when": [
        {
          "fact": "lookup.path",
          "op": "eq",
          "value": "replace"
        }
      ]
    },
    {
      "id": "ful.limit",
      "when": [
        {
          "fact": "calc.remainingAfterCents",
          "op": "lte",
          "value": 0
        }
      ]
    }
  ]
}
