    {
      "id": "E118",
      "name": "Stain claim frequency",
      "class": "C",
      "stage": "frequency_limits",
      "kind": "eligibility",
      "rows": [
        {
          "id": "E118.na",
          "when": [
            {
              "fact": "claim.peril",
              "op": "neq",
              "value": "stain"
            }
          ],
          "then": {
            "outcome": "PASS",
            "noteText": "The limit counts stain claims only."
          }
        },
        {
          "id": "E118.na.heirloom",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "heirloom"
            },
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            }
          ],
          "then": {
            "outcome": "PASS",
            "noteText": "No stain claim limit on this plan."
          }
        },
        {
          "id": "E118.pass.spotless",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "spotless"
            },
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            },
            {
              "fact": "d.stainClaims12m",
              "op": "lt",
              "value": 2
            }
          ],
          "then": {
            "outcome": "PASS"
          }
        },
        {
          "id": "E118.fail.spotless",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "spotless"
            },
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            },
            {
              "fact": "d.stainClaims12m",
              "op": "gte",
              "value": 2
            }
          ],
          "then": {
            "outcome": "DENY",
            "reasonCode": "FREQUENCY_LIMIT",
            "clause": "\u00a77.1",
            "params": {
              "N": 2
            },
            "claimantText": "You have reached the limit of {N} stain claims in 12 months.",
            "noteText": "{count} prior stain claims in 12 months; limit {N}.",
            "bind": {
              "count": "d.stainClaims12m"
            }
          }
        },
        {
          "id": "E118.pass.everyday",
          "when": [
            {
              "fact": "contract.planCode",
              "op": "eq",
              "value": "everyday"
            },
            {
              "fact": "claim.peril",
              "op": "eq",
              "value": "stain"
            },
            {
              "fact": "d.stainClaims12m",
              "op": "lt",
              "value": 3
            }
          ],
          "then": {
            "outcome": "PASS"
